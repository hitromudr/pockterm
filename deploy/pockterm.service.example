# Example systemd unit for pockterm.
# Note: no ProtectSystem/ProtectHome sandboxing here - when pockterm
# bootstraps the tmux server, the whole session tree inherits unit
# restrictions, which would cripple the tools running inside.
[Unit]
Description=pockterm - mobile web terminal for a tmux session
After=network.target

[Service]
Type=simple
User=youruser
Environment=POCKTERM_LISTEN=127.0.0.1:8130
Environment=POCKTERM_SESSION=claude
# Environment=POCKTERM_BOOTSTRAP=/usr/local/bin/claude
Restart=always
RestartSec=3
ExecStart=/usr/local/bin/pockterm

[Install]
WantedBy=multi-user.target
