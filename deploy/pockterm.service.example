# Example systemd unit for pockterm.
# It only lists and attaches to sessions you start yourself, so it needs
# no special environment beyond the listen address (and a token if the
# listen address is not loopback).
[Unit]
Description=pockterm - mobile web terminal for your tmux sessions
After=network.target

[Service]
Type=simple
User=youruser
Environment=POCKTERM_LISTEN=127.0.0.1:8130
# Environment=POCKTERM_TOKEN=change-me   # required if LISTEN is not loopback
Restart=always
RestartSec=3
ExecStart=/usr/local/bin/pockterm

[Install]
WantedBy=multi-user.target
